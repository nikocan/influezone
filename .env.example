# Shopfluence ortam değişkenleri / environment variables
# Bu değerler boş bırakılırsa uygulama DEMO modunda (tarayıcıda yerel örnek veri) çalışır.
# Leave empty to run in DEMO mode (local sample data in the browser).
VITE_SUPABASE_URL=
# Yalnızca anon/publishable anahtar. Service-role anahtarını ASLA buraya koymayın.
VITE_SUPABASE_ANON_KEY=
